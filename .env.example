# Optional server-only OpenAI-compatible endpoint, including /v1 (LiteLLM/vLLM).
# Copy to .env, restart npm run demo. Never use VITE_ for secrets.
AGENT_KNOWLEDGE_HUB_LLM_BASE_URL=http://127.0.0.1:4000/v1
AGENT_KNOWLEDGE_HUB_LLM_MODEL=your-internal-model
AGENT_KNOWLEDGE_HUB_LLM_API_KEY=

# Operational OIDC/PostgreSQL settings: docs/OPERATIONAL_SETUP.md
# Durable web/MCP imports; embedded server worker is enabled by default.
IMPORT_WORKER_ENABLED=true
# Explicit internal principal IDs permitted to approve selected source disclosure.
# Empty keeps team disclosure disabled; personal organization remains available.
IMPORT_DISCLOSURE_REVIEWERS=
# Explicit operator-reviewed initial Owners for adoption of a legacy workspace.
# Obtain verified IDs from /api/v1/me. Existing reviewers never become Admin implicitly.
ACCESS_BOOTSTRAP_OWNERS=
ACCESS_ALLOW_ORG_CREATE=false


# Agent credentials are opt-in until IdP deprovisioning sync has been accepted.
AGENT_KNOWLEDGE_HUB_AGENT_CREDENTIALS_ENABLED=false
# Model route and trusted backend hint (use unknown for dynamic proxy routing).
AGENT_KNOWLEDGE_HUB_LLM_PROVIDER=openai
AGENT_KNOWLEDGE_HUB_LLM_BACKEND=unknown
# SystemOne reviewer aid is independent from wiki generation. Server-side secrets only.
AGENT_KNOWLEDGE_HUB_SYSTEMONE_ALLOW_TRANSMISSION=false
AGENT_KNOWLEDGE_HUB_SYSTEMONE_DESTINATION_ID=
AGENT_KNOWLEDGE_HUB_SYSTEMONE_REVIEW_THRESHOLD=0.5

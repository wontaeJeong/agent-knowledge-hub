{
  "name": "agent-knowledge-hub",
  "version": "0.2.0-demo",
  "private": true,
  "type": "module",
  "description": "LLM 업무 산출물을 연결된 사내 지식으로 만드는 위키 데모",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src && node --test scripts/model-api.test.mjs scripts/doctor.test.mjs scripts/smoke.test.mjs",
    "test:watch": "vitest src",
    "typecheck": "tsc -b --pretty",
    "doctor": "node scripts/doctor.mjs",
    "check": "npm run doctor && npm test && npm run check:requirements && npm run build && npm run test:smoke",
    "test:smoke": "node scripts/smoke.mjs",
    "check:requirements": "node scripts/check-requirements.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "brand": "node scripts/generate-brand.mjs",
    "format": "prettier --write src vite.config.ts scripts"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "lucide-react": "1.61.0",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

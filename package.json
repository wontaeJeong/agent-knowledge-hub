{
  "name": "agent-knowledge-hub",
  "version": "0.2.0-demo",
  "private": true,
  "type": "module",
  "description": "LLM 업무 산출물을 연결된 사내 지식으로 만드는 위키 데모",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src && node --test scripts/model-api.test.mjs scripts/migrate.test.mjs scripts/wiki-connector/*.test.mjs",
    "test:server": "vitest run server --maxWorkers=1",
    "check:server": "tsc -p tsconfig.server.json",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mts",
    "wiki": "node scripts/wiki-connector/cli.mjs",
    "wiki:mcp": "node scripts/wiki-connector/mcp.mjs",
    "check:requirements": "node scripts/check-requirements.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "brand": "node scripts/generate-brand.mjs",
    "format": "prettier --write src vite.config.ts scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "dompurify": "3.4.17",
    "lucide-react": "1.61.0",
    "marked": "18.1.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
